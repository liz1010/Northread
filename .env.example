# 复制成 .env.local 后填写。.env* 已在 .gitignore 里，不会进 Git。

# ---- Claude API ----
# 必填。从 https://console.anthropic.com 拿。
ANTHROPIC_API_KEY=sk-ant-...

# 重排模型：决定"今天读哪三条"的那一步，质量最关键。
NORTHREAD_RERANK_MODEL=claude-opus-5

# 初筛模型：对几十上百条候选做粗筛，调用量最大。
# 默认和重排同一个模型，不替你做降级决定。
# 想省钱可以改成 claude-haiku-4-5，代价是初筛可能漏掉好内容。
NORTHREAD_PREFILTER_MODEL=claude-opus-5

# 推理力度：low | medium | high | xhigh | max
# 初筛用 low 足够（只判断相不相关），重排值得给 high。
NORTHREAD_PREFILTER_EFFORT=low
NORTHREAD_RERANK_EFFORT=high

# ---- 存储 ----
NORTHREAD_DB=./data/northread.db

# ---- 抓取 ----
# 公司网络需要走代理时填，留空表示直连。
# HTTPS_PROXY=http://proxy.example.com:3128

# 单次抓取每个源最多取几条
NORTHREAD_MAX_ITEMS_PER_SOURCE=30

# ---- 开关 ----
# 设成 1 用 MockProvider（规则打分，不调模型），用来在没有 API key
# 或想省钱时跑通整条链路。
NORTHREAD_USE_MOCK=0
