# 复制成 .env.local 后填写。.env* 已在 .gitignore 里，不会进 Git。
# 生产环境用 systemd 的 EnvironmentFile 加载同样这些变量。

# ============ 模型 ============
# 默认走 DeepSeek。换别家只改这两行——provider 是 OpenAI 兼容实现，
# 阿里云百炼 / Ollama / vLLM 都能接。
#
#   DeepSeek     https://api.deepseek.com                              deepseek-chat
#   阿里云百炼    https://dashscope.aliyuncs.com/compatible-mode/v1     qwen-plus
#   Ollama       http://127.0.0.1:11434/v1                             qwen2.5:14b
#   vLLM         http://127.0.0.1:8000/v1                              （看你起的模型名）
NORTHREAD_API_BASE=https://api.deepseek.com
NORTHREAD_API_KEY=sk-...

# 初筛调用量最大、判断最简单；重排决定「今天读哪三条」，质量最关键。
# DeepSeek 两个模型：deepseek-chat（V3，快且便宜）、deepseek-reasoner（R1，会推理）。
NORTHREAD_PREFILTER_MODEL=deepseek-chat
NORTHREAD_RERANK_MODEL=deepseek-chat

# 设成 1 用 MockProvider（关键词打分，不调模型）。
# 用来在没配 key 或想省钱时跑通整条链路，推荐质量会很差。
NORTHREAD_USE_MOCK=0

# ============ 访问控制 ============
# 挂到公网后必须设。两个都缺时 middleware 会直接放行——本机开发方便，
# 但生产环境启动脚本会检查，缺了拒绝启动。
#
# 密码自己定。SESSION_SECRET 用随机串，换掉它会让所有已登录会话失效：
#   openssl rand -hex 32
NORTHREAD_PASSWORD=
NORTHREAD_SESSION_SECRET=

# Nginx 做了 HTTPS 之后设成 1，cookie 才会带 Secure 标记。
# 本机 http 访问时保持 0，否则浏览器不会回传 cookie，会一直跳登录页。
NORTHREAD_HTTPS=0

# ============ 存储 ============
# 生产环境建议用绝对路径，别放在代码目录里——重新部署时不会被覆盖。
NORTHREAD_DB=./data/northread.db

# ============ 抓取 ============
# 阿里云服务器直连境外站点可能很慢或不通（LWN、Substack、arXiv、nitter 都在境外）。
# 有代理就填，没有的话见 deploy/README.md 里关于这件事的说明。
# HTTPS_PROXY=http://127.0.0.1:7890

NORTHREAD_MAX_ITEMS_PER_SOURCE=30

# ============ 运行 ============
PORT=3000
# 0.0.0.0 才能被外部访问。只在本机用就写 127.0.0.1。
HOSTNAME=0.0.0.0
